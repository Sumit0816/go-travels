{
  "name": "go-travels",
  "version": "0.1.0",
  "private": true,
  "description": "Go Travels website and admin CMS — Next.js + Payload CMS + PostgreSQL, bookings sent on WhatsApp.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:local": "node scripts/local-db.mjs",
    "seed": "node --no-deprecation --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "tokens": "tsx scripts/build-tokens.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/unit",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/int --no-file-parallelism",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "clsx": "2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
