# Copy to .env and fill in. Never commit .env.

# --- Core -------------------------------------------------------------------
# Local: `docker compose up -d` (port 5432) or `npm run db:local` (port 5433, no Docker needed)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/go_travels
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Media storage (Phase 2) ---------------------------------------------------
# S3-compatible bucket (Cloudflare R2 / AWS S3). Leave empty to store uploads on local disk.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- WhatsApp (Phase 5) ---------------------------------------------------------
# 32-byte hex key (64 hex chars) that encrypts the aggregator API key stored in the CMS.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_ENC_KEY=
# Shared secret in the delivery-receipt webhook URL set at the aggregator:
#   https://<site>/api/webhooks/whatsapp/gupshup?token=<this value>   (or /interakt)
WHATSAPP_WEBHOOK_SECRET=
# Protects /api/whatsapp/process, which sends due retries. Call it every minute:
#   Vercel: vercel.json cron (Vercel sends this as a Bearer token automatically)
#   VPS:    * * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<site>/api/whatsapp/process
CRON_SECRET=
# Set to "console" to print messages instead of sending them (e.g. on a staging server).
# Without a saved API key, development prints to the console automatically.
WHATSAPP_ADAPTER=

# --- Email (WhatsApp fallback, password resets) ---------------------------------
# Leave SMTP_HOST empty to print emails to the server log instead.
EMAIL_FROM=bookings@gotravels.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Monitoring (Phase 6) -------------------------------------------------------
SENTRY_DSN=

# --- Demo data -----------------------------------------------------------------
# Password for the four seeded CMS users (npm run seed). 12+ characters. Local only.
SEED_USER_PASSWORD=
